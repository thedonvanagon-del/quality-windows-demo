[
  {"start": 0.5,  "end": 5.5,  "text": "Friday morning. Sixty seconds. Grab your mug."},
  {"start": 6.0,  "end": 9.5,  "text": "Sit up. Close your eyes."},
  {"start": 9.5,  "end": 12.5, "text": "Breathe in."},
  {"start": 12.5, "end": 16.0, "text": "And out. Slow."},
  {"start": 16.0, "end": 18.5, "text": "Again. In."},
  {"start": 18.5, "end": 22.0, "text": "And out."},
  {"start": 22.0, "end": 25.0, "text": "The Buddha taught the middle way."},
  {"start": 25.0, "end": 27.5, "text": "Not too tight. Not too loose."},
  {"start": 27.5, "end": 29.5, "text": "Same as a pour-over."},
  {"start": 29.5, "end": 31.0, "text": "Rush it, and it's sour."},
  {"start": 31.0, "end": 32.5, "text": "Stew it, and it's bitter."},
  {"start": 32.5, "end": 35.0, "text": "Slow and steady hits the sweet spot."},
  {"start": 36.0, "end": 38.5, "text": "Nothing lasts."},
  {"start": 38.5, "end": 42.0, "text": "Not the steam. Not the week. Not even the crema."},
  {"start": 42.0, "end": 45.0, "text": "So drink the cup while it's here."},
  {"start": 48.0, "end": 50.5, "text": "Beginner's mind."},
  {"start": 50.5, "end": 53.0, "text": "Every cup is your first cup."},
  {"start": 53.0, "end": 56.5, "text": "Take one sip like you've never tasted coffee."},
  {"start": 57.3, "end": 59.0, "text": "Happy Friday."}
]
